{
  "name": "dsh-fish-pay-counter",
  "version": "1.6.0",
  "type": "module",
  "description": "A draggable DSH fish pet with two outfits, firework quips, an optional daily community feed and a bubble game.",
  "author": "egg2023001-cmd",
  "homepage": "https://dshopen.org/zh/plugins/dsh-fish-pay-counter/",
  "icon": "./icon.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client/icon": "./icon.png",
    "./client/locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "摸鱼",
    "桌宠",
    "宠物",
    "工资计时",
    "工资",
    "salary",
    "pay-counter",
    "desktop-pet",
    "goldfish",
    "pet",
    "dsh",
    "widget",
    "wage",
    "payday",
    "desk-pet",
    "fish",
    "bubble-game",
    "moyu",
    "月薪",
    "薪水",
    "发薪日",
    "打工人",
    "下班"
  ],
  "files": [
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "icon.png",
    "locale/*.json",
    "docs/*.md",
    "market-assets/*.png",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egg2023001-cmd/dsh-fish-pay-counter.git"
  }
}
